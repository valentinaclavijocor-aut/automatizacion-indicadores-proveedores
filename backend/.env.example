# Copia este archivo como ".env" y ajusta los valores. NUNCA subas el archivo ".env".

# Conexion a PostgreSQL (formato: postgresql://usuario:clave@host:puerto/base)
DATABASE_URL=postgresql://haceb_user:cambia_esta_clave@localhost:5432/haceb_indicadores

# Clave para firmar los JWT. Genera una con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origenes permitidos para el frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Solo para el script de datos de prueba (scripts/seed.py)
SEED_ADMIN_EMAIL=admin@demo.com
SEED_ADMIN_PASSWORD=cambia_esta_clave_admin
SEED_DEMO_PASSWORD=cambia_esta_clave_demo

# Solo para docker-compose (PostgreSQL local). Deben coincidir con DATABASE_URL.
POSTGRES_USER=haceb_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=haceb_indicadores
